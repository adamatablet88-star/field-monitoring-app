// Initial relational schema for the project skeleton (roadmap step 1).
// Structural entities (Client..TreatmentWell, User) are modeled fully.
// Visit records are modeled as one table per protocol with a JSON `data`
// column holding the shape defined in packages/shared/src/visits.ts —
// they get fully relational columns once each field form is implemented
// (roadmap steps 4-6), so the schema doesn't need to be re-guessed twice.
//
// Client, Site, Well, Tank, TreatmentSystem, TreatmentWell,
// ParameterConfig, GroundwaterWell, FuelLensVisit, SveSystemVisit,
// BioVentingSystemVisit and GroundwaterVisit additionally carry
// `version`/`updatedAt`/`deletedAt` — sync bookkeeping used by the
// optimistic-concurrency push/pull endpoints in src/sync (roadmap steps
// 2-6). These are server-side only; they're deliberately absent from the
// shared domain types in packages/shared, which describe entity shape,
// not sync state.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  technician
}

model User {
  id           String @id @default(uuid())
  username     String @unique
  passwordHash String
  role         Role
}

model Client {
  id    String @id @default(uuid())
  name  String
  sites Site[]

  version   Int       @default(1)
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([updatedAt])
}

model Site {
  id             String   @id @default(uuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])
  name           String
  location       Json
  protocolTypes  String[] // "fuelLens" | "SVE" | "bioVenting" | "groundwater"

  version   Int       @default(1)
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  wells             Well[]
  tanks             Tank[]
  treatmentSystems  TreatmentSystem[]
  groundwaterWells  GroundwaterWell[]

  @@index([updatedAt])
}

model Well {
  id        String @id @default(uuid())
  siteId    String
  site      Site   @relation(fields: [siteId], references: [id])
  code      String

  // WellIdentity
  x               Float
  y               Float
  z               Float
  manholeMaterial String // "concrete" | "iron"
  manholeSize     String
  wellDepth       Float
  wellDiameter    Float
  screenFrom      Float
  screenTo        Float

  recoveryMethod String // "none" | "passive_skimmer" | "absorbent" | "active_skimmer"
  tankId         String?
  tank           Tank?   @relation(fields: [tankId], references: [id])

  version   Int       @default(1)
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  fuelLensVisits FuelLensVisit[]

  @@index([siteId])
  @@index([updatedAt])
}

model Tank {
  id     String @id @default(uuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id])
  label  String
  wells  Well[]

  version   Int       @default(1)
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([updatedAt])
}

model TreatmentSystem {
  id          String @id @default(uuid())
  siteId      String
  site        Site   @relation(fields: [siteId], references: [id])
  systemType  String // "SVE" | "bioVenting"
  systemLabel String

  version   Int       @default(1)
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  parameters ParameterConfig[]
  wells      TreatmentWell[]

  sveSystemVisits         SveSystemVisit[]
  bioVentingSystemVisits  BioVentingSystemVisit[]

  @@index([siteId])
  @@index([updatedAt])
}

model ParameterConfig {
  id                String          @id @default(uuid())
  systemId          String
  system            TreatmentSystem @relation(fields: [systemId], references: [id])
  label             String
  unit              String
  minValue          Float?
  maxValue          Float?
  required          Boolean
  order             Int
  criticalDirection String // "none" | "above" | "below"
  criticalValue     Float?
  criticalMessage   String

  version   Int       @default(1)
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([systemId])
  @@index([updatedAt])
}

model TreatmentWell {
  id       String          @id @default(uuid())
  systemId String
  system   TreatmentSystem @relation(fields: [systemId], references: [id])
  code     String

  // WellIdentity
  x               Float
  y               Float
  z               Float
  manholeMaterial String
  manholeSize     String
  wellDepth       Float
  wellDiameter    Float
  screenFrom      Float
  screenTo        Float

  wellType String // "treatment" | "monitoring" | "groundwater"

  version   Int       @default(1)
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([systemId])
  @@index([updatedAt])
}

model GroundwaterWell {
  id     String @id @default(uuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id])
  code   String

  // WellIdentity
  x               Float
  y               Float
  z               Float
  manholeMaterial String
  manholeSize     String
  wellDepth       Float
  wellDiameter    Float
  screenFrom      Float
  screenTo        Float

  version   Int       @default(1)
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  groundwaterVisits GroundwaterVisit[]

  @@index([siteId])
  @@index([updatedAt])
}

model FuelLensVisit {
  id        String   @id @default(uuid())
  wellId    String
  well      Well     @relation(fields: [wellId], references: [id])
  visitDate DateTime
  data      Json // full shape: FuelLensVisit in packages/shared/src/visits.ts

  version   Int       @default(1)
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([wellId])
  @@index([updatedAt])
}

model SveSystemVisit {
  id        String          @id @default(uuid())
  systemId  String
  system    TreatmentSystem @relation(fields: [systemId], references: [id])
  visitDate DateTime
  visitType String // "small" | "large" | "baseline"
  data      Json // full shape (incl. nested wellVisits): SveSystemVisit in packages/shared/src/visits.ts

  version   Int       @default(1)
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([systemId])
  @@index([updatedAt])
}

model BioVentingSystemVisit {
  id        String          @id @default(uuid())
  systemId  String
  system    TreatmentSystem @relation(fields: [systemId], references: [id])
  visitDate DateTime
  data      Json // full shape (incl. nested monitoringPoints): BioVentingSystemVisit in packages/shared/src/visits.ts

  version   Int       @default(1)
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([systemId])
  @@index([updatedAt])
}

model GroundwaterVisit {
  id        String          @id @default(uuid())
  wellId    String
  well      GroundwaterWell @relation(fields: [wellId], references: [id])
  visitDate DateTime
  data      Json // full shape: GroundwaterVisit in packages/shared/src/visits.ts

  version   Int       @default(1)
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([wellId])
  @@index([updatedAt])
}
